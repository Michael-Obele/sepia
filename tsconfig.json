{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Server-side code only — the dashboard has its own check
  // (`cd dashboard && bun run check` → svelte-check) and its own tsconfig
  // extending .svelte-kit/tsconfig.json, which this config must not touch.
  "include": ["src", "scripts", "packages", "drizzle.config.ts"],
  "exclude": ["node_modules", "dashboard", "drizzle", "backups", "articles", "plan", "skills", "docs"]
}
