# Copy to .env and fill in real values (Bun loads .env automatically).

# Neon Postgres pooled connection string (create a free project at neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Phase 1 auth token for /mcp and /api/* — generate with: openssl rand -hex 32
# Leave unset for DEV MODE (no auth). NEVER deploy without it.
MCP_BEARER_TOKEN=

# Phase 2 OAuth 2.1 — the login/consent page password (single user).
# Setting this ENABLES the OAuth endpoints (/authorize, /token, /.well-known/*).
# Generate with: openssl rand -hex 16. NOTE: the dashboard signs in with the
# bearer token (MCP_BEARER_TOKEN), not this password.
# Future: multi-account with passkeys/TOTP.
DASHBOARD_PASSWORD=

# OAuth issuer URL — must match the public origin clients reach.
# Defaults to https://sepia.fly.dev; set to http://localhost:8080 for local dev.
OAUTH_ISSUER_URL=

# Port the server listens on (Fly's http_service.internal_port = 8080)
PORT=8080

# ── Multi-tenant accounts (Better Auth) ─────────────────────────────────────
# Required in auth mode. The admin owns pre-tenant data (adopted at boot).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Better Auth secret — generate with: openssl rand -base64 32
# Setting this ENABLES accounts + OAuth endpoints.
BETTER_AUTH_SECRET=
# Public base URL for Better Auth (defaults to OAUTH_ISSUER_URL).
BETTER_AUTH_URL=

# ── Transactional email (password reset) via Resend ────────────────────────
# Free tier: 3,000 emails/mo, 100/day. Get a key at resend.com/api-keys.
RESEND_API_KEY=
# Sender — must be a verified domain in Resend, e.g. "Sepia <no-reply@sepia.svelte-apps.me>"
RESEND_FROM_EMAIL=
# Public app URL used for links in emails (defaults to BETTER_AUTH_URL).
APP_URL=
