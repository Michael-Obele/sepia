# internal planning docs (not for public repo)
# ANCHORED with a leading slash on purpose: a bare `plan/` also matched
# dashboard/src/routes/app/settings/plan/, which silently kept the whole
# "Plan & usage" settings page out of git. Same trap for any bare name.
/plan/
/docs/plans/
/docs/plans/*
