# Sepia dashboard — environment variables
# Copy to .env for local dev. The remote functions connect to Neon directly.

# Neon Postgres connection string (same as the server's DATABASE_URL)
DATABASE_URL=

# Token the sign-in screen validates against. Falls back to MCP_BEARER_TOKEN.
DASHBOARD_TOKEN=

# Browser-side Better Auth client (API keys on the account page).
# In dev, point at the deployed server (has CORS for localhost:5173) or a
# locally running server: VITE_AUTH_URL=http://localhost:8080
VITE_AUTH_URL=https://sepia.fly.dev

# NOTE on the Lemon Squeezy split:
#   - The WEBHOOK (source of truth for users.plan) lives on the Fly app — its
#     secret is LEMONSQUEEZY_WEBHOOK_SECRET in the ROOT .env, never here.
#   - CHECKOUT creation lives HERE (dashboard remote fn) because the Fly API
#     deliberately rejects dashboard sessions (src/auth.ts), while this surface
#     already resolves the session server-side. These are server-only vars
#     ($env/dynamic/private) — they never reach the browser.

# API key — app.lemonsqueezy.com » Settings » API (test-mode key first).
LEMONSQUEEZY_API_KEY=
# Store ID — Settings » Stores → "#123456" → number only.
LEMONSQUEEZY_STORE_ID=
# Variant IDs — Products » Sepia Pro (or the .../checkout/buy/<ID> share URL).
LEMONSQUEEZY_VARIANT_ID_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_PRO_ANNUAL=
# Public app URL — used for the checkout redirect fallback (defaults to
# https://sepia.svelte-apps.me when unset).
APP_URL=https://sepia.svelte-apps.me
