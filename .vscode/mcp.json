{
  "inputs": [
    {
      "type": "promptString",
      "id": "memory-token",
      "description": "Memory MCP Bearer Token (from .env MCP_BEARER_TOKEN)",
      "password": true
    }
  ],
  "servers": {
    // Local Sepia, running in Docker against the prod data plane (Neon) —
    // see docker-compose.yml. Pointing here instead of
    // https://sepia.fly.dev means daily traffic never wakes the Fly Machine,
    // which stays asleep for the endpoints that must be public.
    //
    // Port 8484 is the CONTAINER's: docker-compose.yml pins `PORT: 8484` for the
    // service and maps `ports: "8484:8484"`. .env's PORT is the separate
    // `bun run dev` port (9630), so dev and the container can run together.
    "sepia-local": {
      "type": "http",
      "url": "http://localhost:8484/mcp",
      "headers": {
        "Authorization": "Bearer ${input:memory-token}"
      }
    }
  }
}
